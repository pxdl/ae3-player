{
  "name": "ae3-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side Ape Escape 3 asset lab for audio, FMV, images, I3D models, skeletal animation, and collision.",
  "scripts": {
    "postinstall": "node scripts/patch-mediabunny-mpeg2.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/gen-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:scheduler": "node --experimental-strip-types --test tests/movie-scheduler.test.ts",
    "sync-sdk": "sh scripts/sync-sdk.sh"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "mediabunny": "^1.50.9",
    "three": "^0.185.1"
  }
}
